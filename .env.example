# Local rehearsal works without credentials. Restart after editing.
HOST=127.0.0.1
PORT=4310
PUBLIC_URL=http://localhost:4310
# Required when binding to any non-loopback interface. Use a long random value.
ADMIN_TOKEN=
# Enable only after Codex CLI login and a successful local smoke run.
ENABLE_CODEX=false
# Omit model to use the signed-in account's configured default.
CODEX_MODEL=
CODEX_TIMEOUT_MS=90000
# Optional absolute executable path (useful for Windows desktop's bundled CLI).
CODEX_PATH=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# OAuth callback: PUBLIC_URL/auth/twitch/callback
# Gemini is optional in rehearsal, required for free-form live screening.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
